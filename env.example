# ==============================================================================
# Environment variables required by every app in apps/*
# ==============================================================================
# Copy this file to .env.local inside EACH app that needs it (apps/school-portal,
# apps/staff-portal, apps/school-admin, apps/platform-admin, apps/government-portal)
# -- Next.js reads .env.local per-app, not from the repo root.
#
# .env.local is already covered by .gitignore -- never commit real values.
# ==============================================================================

# Get real values by running `supabase start` then `supabase status`.
# The status output includes an "API URL" and an "anon key" line -- copy
# those exactly. For local dev these values are stable across resets (they
# only change if you regenerate local keys), so you should rarely need to
# repeat this step.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-the-anon-key-from-supabase-status-here
